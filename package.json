import type { Metadata } from "next";
import { Suspense } from "react";
import prisma from "@/lib/prisma";
import Breadcrumbs from "@/components/ui/Breadcrumbs";
import CatalogFilters from "@/components/catalog/CatalogFilters";
import ProductsGrid from "@/components/catalog/ProductsGrid";
import CatalogSkeleton from "@/components/catalog/CatalogSkeleton";
import type { Prisma } from "@prisma/client";

export const metadata: Metadata = {
  title: "Каталог продукции — EPDM крошка, резиновая крошка, клей",
  description:
    "Полный каталог продукции MOSEPDM: ЭПДМ крошка, резиновая крошка, полиуретановый клей, готовые резиновые изделия. Оптовые цены. Доставка по России.",
};

interface CatalogPageProps {
  searchParams: {
    category?: string;
    series?: string;
    sort?: string;
    page?: string;
    inStock?: string;
  };
}

const PAGE_SIZE = 12;

export default async function CatalogPage({ searchParams }: CatalogPageProps) {
  const page = Number(searchParams.page ?? 1);
  const skip = (page - 1) * PAGE_SIZE;

  const where: Prisma.ProductWhereInput = {};
  if (searchParams.category) {
    where.category = { slug: searchParams.category };
  }
  if (searchParams.series) {
    where.series = searchParams.series.toUpperCase() as Prisma.ProductWhereInput["series"];
  }
  if (searchParams.inStock === "true") {
    where.inStock = true;
  }

  let orderBy: Prisma.ProductOrderByWithRelationInput = { createdAt: "desc" };
  if (searchParams.sort === "price-asc") orderBy = { price: "asc" };
  if (searchParams.sort === "price-desc") orderBy = { price: "desc" };
  if (searchParams.sort === "popular") orderBy = { popular: "desc" };

  const [products, total, categories] = await Promise.all([
    prisma.product.findMany({
      where,
      orderBy,
      skip,
      take: PAGE_SIZE,
      include: { category: true },
    }),
    prisma.product.count({ where }),
    prisma.category.findMany({ orderBy: { order: "asc" } }),
  ]);

  const totalPages = Math.ceil(total / PAGE_SIZE);

  return (
    <div className="pt-20 min-h-screen bg-gray-50">
      <div className="container-custom py-8">
        <Breadcrumbs
          items={[{ label: "Главная", href: "/" }, { label: "Каталог" }]}
        />

        <div className="mt-6 mb-8">
          <h1 className="text-h1 font-bold text-gray-900">Каталог продукции</h1>
          <p className="text-gray-500 mt-2">
            {total} {getPluralForm(total, ["товар", "товара", "товаров"])}
          </p>
        </div>

        <div className="flex flex-col lg:flex-row gap-8">
          {/* Filters sidebar */}
          <aside className="w-full lg:w-64 flex-shrink-0">
            <CatalogFilters
              categories={categories}
              currentCategory={searchParams.category}
              currentSeries={searchParams.series}
              currentSort={searchParams.sort}
              inStock={searchParams.inStock}
            />
          </aside>

          {/* Products */}
          <div className="flex-1">
            <Suspense fallback={<CatalogSkeleton />}>
              <ProductsGrid
                products={products}
                page={page}
                totalPages={totalPages}
              />
            </Suspense>
          </div>
        </div>
      </div>
    </div>
  );
}

function getPluralForm(n: number, forms: [string, string, string]): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return forms[0];
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return forms[1];
  return forms[2];
}
